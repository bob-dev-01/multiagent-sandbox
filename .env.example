# Copy to .env and fill in. .env is gitignored and never committed.

# Anthropic API key — required for the generator (Sonnet 5) and judge (Opus 5).
ANTHROPIC_API_KEY=

# Azure — filled in after infra deployment (Phase 1).
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-agentfactory-dev
AZURE_LOCATION=centralindia
AZURE_KEY_VAULT_NAME=
AZURE_STORAGE_ACCOUNT=
AZURE_AKS_CLUSTER=
AZURE_ACI_SUBNET_ID=

# PostgreSQL — Agent Registry. Local dev may point at a container.
AGENTFACTORY_DB_DSN=postgresql://postgres:postgres@localhost:5432/agentfactory

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Run configuration
AGENTFACTORY_ENV=local
AGENTFACTORY_LOG_DIR=./runs
